<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/surface">
    <ImageView android:id="@+id/ivAvatar" android:layout_width="48dp" android:layout_height="48dp"
        android:contentDescription="Ảnh đại diện" android:scaleType="centerCrop"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginHorizontal="12dp">
        <TextView android:id="@+id/tvName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tvLastMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tvConversationTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvUnread" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_yellow" android:textColor="#000000" android:padding="6dp"/>
    <Button android:id="@+id/btnQuickCall" android:layout_width="wrap_content" android:layout_height="48dp"
        android:text="@string/btn_call"/>
</LinearLayout>
