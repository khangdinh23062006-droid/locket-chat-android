<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Bong bóng tin nhắn Text -->
    <TextView
        android:id="@+id/tvSentMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@color/bubble_sent"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="Nội dung gửi..."
        android:textColor="@color/bubble_sent_text"
        android:textSize="14sp" />

    <!-- Bong bóng tin nhắn Hình ảnh -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSentImage"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <ImageView
            android:id="@+id/ivSentImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <!-- Khung hiển thị bình luận Khoảnh khắc Locket (Chuẩn Ảnh 1) -->
    <LinearLayout
        android:id="@+id/layoutSentMomentReply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:backgroundTint="#1A1A1A"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivSentMomentImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <!-- Badge người sở hữu khoảnh khắc ở góc trên ảnh -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_pill_friends"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/tvSentMomentBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khoảnh khắc"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSentMomentComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxWidth="260dp"
            android:background="@color/bubble_sent"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="@color/bubble_sent_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bong bóng tin nhắn File tài liệu -->
    <LinearLayout
        android:id="@+id/layoutSentFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="260dp"
        android:background="@color/bubble_sent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSentFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="document.pdf"
                android:textColor="@color/bubble_sent_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSentFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.2 MB"
                android:textColor="#444444"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
